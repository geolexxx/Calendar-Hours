{
  "manifest_version": 3,
  "name": "Calendar Hours — Project Time Tracking",
  "short_name": "Calendar Hours",
  "version": "0.1.0",
  "description": "Track project hours alongside Google Calendar for free, with a separate work timer.",
  "minimum_chrome_version": "116",
  "permissions": ["identity", "storage", "sidePanel"],
  "host_permissions": ["https://www.googleapis.com/*"],
  "background": {"service_worker": "background.js"},
  "side_panel": {"default_path": "panel.html"},
  "action": {"default_title": "Open the Calendar Hours panel"},
  "oauth2": {
    "client_id": "REPLACE_ME.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/calendar.readonly"]
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
